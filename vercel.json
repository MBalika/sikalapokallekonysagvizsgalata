{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    { "source": "/img/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=86400" } ] },
    { "source": "/video/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=3600" } ] }
  ]
}
